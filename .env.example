# --- Core ---
# Local dev: SQLite file. Production: Postgres URL e.g.
# DATABASE_URL=postgres://user:pass@host:5432/talkex_business?sslmode=require
DATABASE_URL=sqlite://talkex_business.db

# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=changeme-generate-a-real-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

PORT=8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Used by OAuth callback + password-reset email links + widget snippet
# BASE_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:5173

# --- AI (optional) ---
# Without ANTHROPIC_API_KEY the AI panel returns keyword-heuristic
# responses so the UI still works.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# --- OAuth social login (optional) ---
# Without these, the OAuth buttons run a simulated login in dev mode.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_SECRET=
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_SECRET=

# --- Razorpay payments (optional) ---
# Without these, /payments/dev-simulate can mark orders paid manually.
# In production, the webhook fails closed unless the secret is set.
# RAZORPAY_KEY_ID=
# RAZORPAY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Cloud API + template submission (optional) ---
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_WABA_ID=
