# Local dev: SQLite file. Production: Postgres URL e.g.
# DATABASE_URL=postgres://user:pass@host:5432/talkex_business?sslmode=require
DATABASE_URL=sqlite://talkex_business.db

# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=changeme-generate-a-real-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

PORT=8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
