# Local dev default: SQLite file. Production: swap for a Postgres URL, e.g.
# postgresql+asyncpg://user:pass@host:5432/talkex_business
# (enterprise scale + concurrent writes for campaigns/wallet/billing need
# real transactional guarantees — see CONTEXT.md).
DATABASE_URL=sqlite+aiosqlite:///./talkex_business.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
